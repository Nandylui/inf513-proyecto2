digraph G {
  rankdir=LR; splines=true; nodesep=0.35; ranksep=0.7; node [shape=plain,fontname="Helvetica"]; edge [color="#64748b",arrowsize=0.6];
  labelloc=t; fontsize=15; label="Módulo de pagos electrónicos";
  concepto_pago [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#fce7f3"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>concepto_pago</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_concepto"><FONT POINT-SIZE="10"><B>id_concepto</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="codigo"><FONT POINT-SIZE="10">codigo <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre"><FONT POINT-SIZE="10">nombre <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="descripcion"><FONT POINT-SIZE="10">descripcion <FONT COLOR="#64748b" POINT-SIZE="8">text</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="monto"><FONT POINT-SIZE="10">monto <FONT COLOR="#64748b" POINT-SIZE="8">numeric</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="permite_plan"><FONT POINT-SIZE="10">permite_plan <FONT COLOR="#64748b" POINT-SIZE="8">boolean</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="max_cuotas"><FONT POINT-SIZE="10">max_cuotas <FONT COLOR="#64748b" POINT-SIZE="8">smallint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activo"><FONT POINT-SIZE="10">activo <FONT COLOR="#64748b" POINT-SIZE="8">boolean</FONT></FONT></TD></TR></TABLE>>];
  metodo_pago [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#fce7f3"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>metodo_pago</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_metodo"><FONT POINT-SIZE="10"><B>id_metodo</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario"><FONT POINT-SIZE="10">id_usuario (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo"><FONT POINT-SIZE="10">tipo <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="alias"><FONT POINT-SIZE="10">alias <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="titular"><FONT POINT-SIZE="10">titular <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="marca"><FONT POINT-SIZE="10">marca <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ultimos4"><FONT POINT-SIZE="10">ultimos4 <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="vencimiento"><FONT POINT-SIZE="10">vencimiento <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="predeterminado"><FONT POINT-SIZE="10">predeterminado <FONT COLOR="#64748b" POINT-SIZE="8">boolean</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT POINT-SIZE="10">created_at <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><FONT POINT-SIZE="10">updated_at <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR></TABLE>>];
  plan_pago [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#fce7f3"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>plan_pago</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_plan"><FONT POINT-SIZE="10"><B>id_plan</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario"><FONT POINT-SIZE="10">id_usuario (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_concepto"><FONT POINT-SIZE="10">id_concepto (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="monto_total"><FONT POINT-SIZE="10">monto_total <FONT COLOR="#64748b" POINT-SIZE="8">numeric</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="num_cuotas"><FONT POINT-SIZE="10">num_cuotas <FONT COLOR="#64748b" POINT-SIZE="8">smallint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado"><FONT POINT-SIZE="10">estado <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT POINT-SIZE="10">created_at <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><FONT POINT-SIZE="10">updated_at <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR></TABLE>>];
  cuota [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#fce7f3"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>cuota</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_cuota"><FONT POINT-SIZE="10"><B>id_cuota</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_plan"><FONT POINT-SIZE="10">id_plan (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="numero"><FONT POINT-SIZE="10">numero <FONT COLOR="#64748b" POINT-SIZE="8">smallint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="monto"><FONT POINT-SIZE="10">monto <FONT COLOR="#64748b" POINT-SIZE="8">numeric</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_vencimiento"><FONT POINT-SIZE="10">fecha_vencimiento <FONT COLOR="#64748b" POINT-SIZE="8">date</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado"><FONT POINT-SIZE="10">estado <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_pago"><FONT POINT-SIZE="10">id_pago <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_pago"><FONT POINT-SIZE="10">fecha_pago <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR></TABLE>>];
  pago [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#fce7f3"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>pago</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_pago"><FONT POINT-SIZE="10"><B>id_pago</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario"><FONT POINT-SIZE="10">id_usuario (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_concepto"><FONT POINT-SIZE="10">id_concepto (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_metodo"><FONT POINT-SIZE="10">id_metodo (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_plan"><FONT POINT-SIZE="10">id_plan <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_cuota"><FONT POINT-SIZE="10">id_cuota <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo"><FONT POINT-SIZE="10">tipo <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="monto"><FONT POINT-SIZE="10">monto <FONT COLOR="#64748b" POINT-SIZE="8">numeric</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="moneda"><FONT POINT-SIZE="10">moneda <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado"><FONT POINT-SIZE="10">estado <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="referencia"><FONT POINT-SIZE="10">referencia <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="codigo_autorizacion"><FONT POINT-SIZE="10">codigo_autorizacion <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="motivo_rechazo"><FONT POINT-SIZE="10">motivo_rechazo <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="detalle_metodo"><FONT POINT-SIZE="10">detalle_metodo <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observacion"><FONT POINT-SIZE="10">observacion <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT POINT-SIZE="10">created_at <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><FONT POINT-SIZE="10">updated_at <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR></TABLE>>];
  usuario [shape=box, style="rounded,dashed", fontname="Helvetica", label="usuario\n(otro módulo)"];
  metodo_pago:id_usuario -> usuario [arrowhead=normal, style=dashed];
  plan_pago:id_usuario -> usuario [arrowhead=normal, style=dashed];
  plan_pago:id_concepto -> concepto_pago [arrowhead=normal];
  cuota:id_plan -> plan_pago [arrowhead=normal];
  pago:id_usuario -> usuario [arrowhead=normal, style=dashed];
  pago:id_concepto -> concepto_pago [arrowhead=normal];
  pago:id_metodo -> metodo_pago [arrowhead=normal];
}