APP_NAME="Consejo Facultativo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/La_Paz

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- PostgreSQL ---------------------------------------------------------------
# Servidor de la cátedra: db.tecnoweb.org.bo  | BD: db_grupo07sa | usuario: grupo07sa
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_grupo07sa
DB_USERNAME=grupo07sa
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# --- Frontend React ---------------------------------------------------------------
# En producción la SPA y la API comparten URL (https://www.tecnoweb.org.bo/inf513/grupo07sa/proyecto2), así que no se usa CORS.
# En desarrollo (Vite, puerto 5173) ya está permitido por defecto; agregue aquí otros orígenes separados por coma.
FRONTEND_URL=

# --- Seguridad de sesión -------------------------------------------------------------
# Minutos de vida del token de acceso (Sanctum). Al vencer, la SPA cierra la sesión y pide ingresar de nuevo.
SANCTUM_EXPIRACION_MIN=480

# --- Correo saliente (SMTP puerto 25 sin cifrado, como en tecnoweb.org.bo) ----------
# En desarrollo local sin servidor SMTP usa MAIL_MAILER=log
MAIL_MAILER=log
MAIL_HOST=mail.tecnoweb.org.bo
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="grupo07sa@tecnoweb.org.bo"
MAIL_FROM_NAME="Consejo Facultativo"

# --- Correo entrante: Sistema Vía Mail (POP3 puerto 110, usuario SIN dominio) -------
GRUPO=grupo07sa
CONSEJO_MAIL_DIRECCION=grupo07sa@tecnoweb.org.bo
CONSEJO_POP3_HOST=mail.tecnoweb.org.bo
CONSEJO_POP3_PUERTO=110
CONSEJO_POP3_USUARIO=grupo07sa
CONSEJO_POP3_CLAVE=
CONSEJO_MAIL_INTERVALO=30
CONSEJO_MAIL_ANONIMOS=false
CONSEJO_NOTIFICAR_POR_CORREO=false

# --- Usuario administrador inicial (seeder) -------------------------------------
ADMIN_CI=1000000
ADMIN_CORREO=admin@consejo.test
ADMIN_CLAVE=Admin2026*
# SEED_DEMO crea usuarios de ejemplo (contraseña Consejo2026*); SEED_HISTORICO agrega 4 sesiones históricas, pagos de ejemplo,
# tráfico de bitácora y contadores de visitas para que el panel y los gráficos tengan datos. Ponga ambos en false en producción real.
SEED_DEMO=true
SEED_HISTORICO=true
