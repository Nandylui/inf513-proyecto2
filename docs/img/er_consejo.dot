digraph G {
  rankdir=LR; splines=true; nodesep=0.35; ranksep=0.7; node [shape=plain,fontname="Helvetica"]; edge [color="#64748b",arrowsize=0.6];
  labelloc=t; fontsize=15; label="Consejo: mandatos, sesiones, excusas y asistencia";
  mandato [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#dcfce7"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>mandato</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_mandato"><FONT POINT-SIZE="10"><B>id_mandato</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_titular"><FONT POINT-SIZE="10">id_titular (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_suplente"><FONT POINT-SIZE="10">id_suplente (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="carrera"><FONT POINT-SIZE="10">carrera <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estamento"><FONT POINT-SIZE="10">estamento <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_inicio"><FONT POINT-SIZE="10">fecha_inicio <FONT COLOR="#64748b" POINT-SIZE="8">date</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_fin"><FONT POINT-SIZE="10">fecha_fin <FONT COLOR="#64748b" POINT-SIZE="8">date</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado"><FONT POINT-SIZE="10">estado <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT POINT-SIZE="10">created_at <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><FONT POINT-SIZE="10">updated_at <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR></TABLE>>];
  sesion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#dcfce7"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>sesion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_sesion"><FONT POINT-SIZE="10"><B>id_sesion</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_hora"><FONT POINT-SIZE="10">fecha_hora <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="lugar"><FONT POINT-SIZE="10">lugar <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo"><FONT POINT-SIZE="10">tipo <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado"><FONT POINT-SIZE="10">estado <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="orden_del_dia"><FONT POINT-SIZE="10">orden_del_dia <FONT COLOR="#64748b" POINT-SIZE="8">text</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="convocada_por"><FONT POINT-SIZE="10">convocada_por <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_convocante"><FONT POINT-SIZE="10">id_convocante (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="numero_solicitantes"><FONT POINT-SIZE="10">numero_solicitantes <FONT COLOR="#64748b" POINT-SIZE="8">smallint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="publica"><FONT POINT-SIZE="10">publica <FONT COLOR="#64748b" POINT-SIZE="8">boolean</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quorum_requerido"><FONT POINT-SIZE="10">quorum_requerido <FONT COLOR="#64748b" POINT-SIZE="8">smallint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quorum_presentes"><FONT POINT-SIZE="10">quorum_presentes <FONT COLOR="#64748b" POINT-SIZE="8">smallint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="quorum_alcanzado"><FONT POINT-SIZE="10">quorum_alcanzado <FONT COLOR="#64748b" POINT-SIZE="8">boolean</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT POINT-SIZE="10">created_at <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><FONT POINT-SIZE="10">updated_at <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR></TABLE>>];
  punto_orden_dia [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#dcfce7"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>punto_orden_dia</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_punto"><FONT POINT-SIZE="10"><B>id_punto</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_sesion"><FONT POINT-SIZE="10">id_sesion (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="numero"><FONT POINT-SIZE="10">numero <FONT COLOR="#64748b" POINT-SIZE="8">smallint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="titulo"><FONT POINT-SIZE="10">titulo <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="descripcion"><FONT POINT-SIZE="10">descripcion <FONT COLOR="#64748b" POINT-SIZE="8">text</FONT></FONT></TD></TR></TABLE>>];
  excusa [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#dcfce7"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>excusa</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_excusa"><FONT POINT-SIZE="10"><B>id_excusa</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_titular"><FONT POINT-SIZE="10">id_titular (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_sesion"><FONT POINT-SIZE="10">id_sesion (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="motivo"><FONT POINT-SIZE="10">motivo <FONT COLOR="#64748b" POINT-SIZE="8">text</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="archivo_nombre"><FONT POINT-SIZE="10">archivo_nombre <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="archivo_path"><FONT POINT-SIZE="10">archivo_path <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="archivo_hash"><FONT POINT-SIZE="10">archivo_hash <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="firmado_digitalmente"><FONT POINT-SIZE="10">firmado_digitalmente <FONT COLOR="#64748b" POINT-SIZE="8">boolean</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_registro"><FONT POINT-SIZE="10">fecha_registro <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR></TABLE>>];
  habilitacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#dcfce7"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>habilitacion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_habilitacion"><FONT POINT-SIZE="10"><B>id_habilitacion</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_sesion"><FONT POINT-SIZE="10">id_sesion (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_mandato"><FONT POINT-SIZE="10">id_mandato (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_titular"><FONT POINT-SIZE="10">id_titular (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_habilitado"><FONT POINT-SIZE="10">id_habilitado (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="motivo"><FONT POINT-SIZE="10">motivo <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="constancia"><FONT POINT-SIZE="10">constancia <FONT COLOR="#64748b" POINT-SIZE="8">text</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha"><FONT POINT-SIZE="10">fecha <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR></TABLE>>];
  asistencia [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#dcfce7"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>asistencia</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_asistencia"><FONT POINT-SIZE="10"><B>id_asistencia</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_sesion"><FONT POINT-SIZE="10">id_sesion (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario"><FONT POINT-SIZE="10">id_usuario (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_mandato"><FONT POINT-SIZE="10">id_mandato (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="metodo"><FONT POINT-SIZE="10">metodo <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="dispositivo"><FONT POINT-SIZE="10">dispositivo <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="es_suplente"><FONT POINT-SIZE="10">es_suplente <FONT COLOR="#64748b" POINT-SIZE="8">boolean</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hora_ingreso"><FONT POINT-SIZE="10">hora_ingreso <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR></TABLE>>];
  acta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#dcfce7"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>acta</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_acta"><FONT POINT-SIZE="10"><B>id_acta</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_sesion"><FONT POINT-SIZE="10">id_sesion (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="contenido"><FONT POINT-SIZE="10">contenido <FONT COLOR="#64748b" POINT-SIZE="8">text</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hash"><FONT POINT-SIZE="10">hash <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="generado_por"><FONT POINT-SIZE="10">generado_por (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT POINT-SIZE="10">created_at <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><FONT POINT-SIZE="10">updated_at <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR></TABLE>>];
  usuario [shape=box, style="rounded,dashed", fontname="Helvetica", label="usuario\n(otro módulo)"];
  mandato:id_titular -> usuario [arrowhead=normal, style=dashed];
  mandato:id_suplente -> usuario [arrowhead=normal, style=dashed];
  sesion:id_convocante -> usuario [arrowhead=normal, style=dashed];
  punto_orden_dia:id_sesion -> sesion [arrowhead=normal];
  excusa:id_titular -> usuario [arrowhead=normal, style=dashed];
  excusa:id_sesion -> sesion [arrowhead=normal];
  habilitacion:id_sesion -> sesion [arrowhead=normal];
  habilitacion:id_mandato -> mandato [arrowhead=normal];
  habilitacion:id_titular -> usuario [arrowhead=normal, style=dashed];
  habilitacion:id_habilitado -> usuario [arrowhead=normal, style=dashed];
  asistencia:id_sesion -> sesion [arrowhead=normal];
  asistencia:id_usuario -> usuario [arrowhead=normal, style=dashed];
  asistencia:id_mandato -> mandato [arrowhead=normal];
  acta:id_sesion -> sesion [arrowhead=normal];
  acta:generado_por -> usuario [arrowhead=normal, style=dashed];
}