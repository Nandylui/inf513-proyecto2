digraph G {
  rankdir=LR; splines=true; nodesep=0.35; ranksep=0.7; node [shape=plain,fontname="Helvetica"]; edge [color="#64748b",arrowsize=0.6];
  labelloc=t; fontsize=15; label="Trámites: documentos, flujo de validación, votación y resoluciones";
  tipo_tramite [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#fef3c7"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>tipo_tramite</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_tipo_tramite"><FONT POINT-SIZE="10"><B>id_tipo_tramite</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre"><FONT POINT-SIZE="10">nombre <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="articulo"><FONT POINT-SIZE="10">articulo <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mayoria"><FONT POINT-SIZE="10">mayoria <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="descripcion"><FONT POINT-SIZE="10">descripcion <FONT COLOR="#64748b" POINT-SIZE="8">text</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activo"><FONT POINT-SIZE="10">activo <FONT COLOR="#64748b" POINT-SIZE="8">boolean</FONT></FONT></TD></TR></TABLE>>];
  flujo_paso [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#fef3c7"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>flujo_paso</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_flujo_paso"><FONT POINT-SIZE="10"><B>id_flujo_paso</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_tipo_tramite"><FONT POINT-SIZE="10">id_tipo_tramite (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="orden"><FONT POINT-SIZE="10">orden <FONT COLOR="#64748b" POINT-SIZE="8">smallint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_rol"><FONT POINT-SIZE="10">id_rol (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR></TABLE>>];
  documento [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#fef3c7"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>documento</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_documento"><FONT POINT-SIZE="10"><B>id_documento</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="titulo"><FONT POINT-SIZE="10">titulo <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="descripcion"><FONT POINT-SIZE="10">descripcion <FONT COLOR="#64748b" POINT-SIZE="8">text</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_remitente"><FONT POINT-SIZE="10">id_remitente (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_sesion"><FONT POINT-SIZE="10">id_sesion (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_punto"><FONT POINT-SIZE="10">id_punto (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_tipo_tramite"><FONT POINT-SIZE="10">id_tipo_tramite (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado"><FONT POINT-SIZE="10">estado <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="prioridad"><FONT POINT-SIZE="10">prioridad <FONT COLOR="#64748b" POINT-SIZE="8">smallint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="version_actual"><FONT POINT-SIZE="10">version_actual <FONT COLOR="#64748b" POINT-SIZE="8">smallint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="paso_actual"><FONT POINT-SIZE="10">paso_actual <FONT COLOR="#64748b" POINT-SIZE="8">smallint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_recepcion"><FONT POINT-SIZE="10">fecha_recepcion <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR></TABLE>>];
  documento_version [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#fef3c7"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>documento_version</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_version"><FONT POINT-SIZE="10"><B>id_version</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_documento"><FONT POINT-SIZE="10">id_documento (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="numero"><FONT POINT-SIZE="10">numero <FONT COLOR="#64748b" POINT-SIZE="8">smallint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="archivo_nombre"><FONT POINT-SIZE="10">archivo_nombre <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="archivo_path"><FONT POINT-SIZE="10">archivo_path <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="archivo_hash"><FONT POINT-SIZE="10">archivo_hash <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_subido_por"><FONT POINT-SIZE="10">id_subido_por (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="comentario"><FONT POINT-SIZE="10">comentario <FONT COLOR="#64748b" POINT-SIZE="8">text</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT POINT-SIZE="10">created_at <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR></TABLE>>];
  validacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#fef3c7"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>validacion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_validacion"><FONT POINT-SIZE="10"><B>id_validacion</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_documento"><FONT POINT-SIZE="10">id_documento (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario"><FONT POINT-SIZE="10">id_usuario (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_rol"><FONT POINT-SIZE="10">id_rol (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="paso"><FONT POINT-SIZE="10">paso <FONT COLOR="#64748b" POINT-SIZE="8">smallint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="decision"><FONT POINT-SIZE="10">decision <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observaciones"><FONT POINT-SIZE="10">observaciones <FONT COLOR="#64748b" POINT-SIZE="8">text</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha"><FONT POINT-SIZE="10">fecha <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR></TABLE>>];
  votacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#fef3c7"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>votacion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_votacion"><FONT POINT-SIZE="10"><B>id_votacion</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_sesion"><FONT POINT-SIZE="10">id_sesion (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_documento"><FONT POINT-SIZE="10">id_documento (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario"><FONT POINT-SIZE="10">id_usuario (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="voto"><FONT POINT-SIZE="10">voto <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha"><FONT POINT-SIZE="10">fecha <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR></TABLE>>];
  resolucion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#fef3c7"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>resolucion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_resolucion"><FONT POINT-SIZE="10"><B>id_resolucion</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="numero"><FONT POINT-SIZE="10">numero <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_documento"><FONT POINT-SIZE="10">id_documento (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_sesion"><FONT POINT-SIZE="10">id_sesion (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_tipo_tramite"><FONT POINT-SIZE="10">id_tipo_tramite (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mayoria_requerida"><FONT POINT-SIZE="10">mayoria_requerida <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="presentes"><FONT POINT-SIZE="10">presentes <FONT COLOR="#64748b" POINT-SIZE="8">smallint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="votos_favor"><FONT POINT-SIZE="10">votos_favor <FONT COLOR="#64748b" POINT-SIZE="8">smallint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="votos_contra"><FONT POINT-SIZE="10">votos_contra <FONT COLOR="#64748b" POINT-SIZE="8">smallint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="votos_blanco"><FONT POINT-SIZE="10">votos_blanco <FONT COLOR="#64748b" POINT-SIZE="8">smallint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="resultado"><FONT POINT-SIZE="10">resultado <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado"><FONT POINT-SIZE="10">estado <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_aprobacion"><FONT POINT-SIZE="10">fecha_aprobacion <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_limite_promulgacion"><FONT POINT-SIZE="10">fecha_limite_promulgacion <FONT COLOR="#64748b" POINT-SIZE="8">date</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_promulgacion"><FONT POINT-SIZE="10">fecha_promulgacion <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_veto"><FONT POINT-SIZE="10">fecha_veto <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="veto_fundamento"><FONT POINT-SIZE="10">veto_fundamento <FONT COLOR="#64748b" POINT-SIZE="8">text</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha_publicacion"><FONT POINT-SIZE="10">fecha_publicacion <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="gaceta_referencia"><FONT POINT-SIZE="10">gaceta_referencia <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR></TABLE>>];
  punto_orden_dia [shape=box, style="rounded,dashed", fontname="Helvetica", label="punto_orden_dia\n(otro módulo)"];
  sesion [shape=box, style="rounded,dashed", fontname="Helvetica", label="sesion\n(otro módulo)"];
  usuario [shape=box, style="rounded,dashed", fontname="Helvetica", label="usuario\n(otro módulo)"];
  rol [shape=box, style="rounded,dashed", fontname="Helvetica", label="rol\n(otro módulo)"];
  flujo_paso:id_tipo_tramite -> tipo_tramite [arrowhead=normal];
  flujo_paso:id_rol -> rol [arrowhead=normal, style=dashed];
  documento:id_remitente -> usuario [arrowhead=normal, style=dashed];
  documento:id_sesion -> sesion [arrowhead=normal, style=dashed];
  documento:id_punto -> punto_orden_dia [arrowhead=normal, style=dashed];
  documento:id_tipo_tramite -> tipo_tramite [arrowhead=normal];
  documento_version:id_documento -> documento [arrowhead=normal];
  documento_version:id_subido_por -> usuario [arrowhead=normal, style=dashed];
  validacion:id_documento -> documento [arrowhead=normal];
  validacion:id_usuario -> usuario [arrowhead=normal, style=dashed];
  validacion:id_rol -> rol [arrowhead=normal, style=dashed];
  votacion:id_sesion -> sesion [arrowhead=normal, style=dashed];
  votacion:id_documento -> documento [arrowhead=normal];
  votacion:id_usuario -> usuario [arrowhead=normal, style=dashed];
  resolucion:id_documento -> documento [arrowhead=normal];
  resolucion:id_sesion -> sesion [arrowhead=normal, style=dashed];
  resolucion:id_tipo_tramite -> tipo_tramite [arrowhead=normal];
}