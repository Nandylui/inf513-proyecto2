digraph G {
  rankdir=TB; splines=true; nodesep=0.35; ranksep=0.7; node [shape=plain,fontname="Helvetica"]; edge [color="#64748b",arrowsize=0.6];
  labelloc=t; fontsize=15; label="Seguridad, RBAC, menú dinámico, bitácora y visitas";
  usuario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#dbeafe"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>usuario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario"><FONT POINT-SIZE="10"><B>id_usuario</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ci"><FONT POINT-SIZE="10">ci <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombres"><FONT POINT-SIZE="10">nombres <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="apellidos"><FONT POINT-SIZE="10">apellidos <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="correo"><FONT POINT-SIZE="10">correo <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="telefono"><FONT POINT-SIZE="10">telefono <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password"><FONT POINT-SIZE="10">password <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_rol"><FONT POINT-SIZE="10">id_rol (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado"><FONT POINT-SIZE="10">estado <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT POINT-SIZE="10">created_at <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at"><FONT POINT-SIZE="10">updated_at <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="preferencias"><FONT POINT-SIZE="10">preferencias <FONT COLOR="#64748b" POINT-SIZE="8">json</FONT></FONT></TD></TR></TABLE>>];
  rol [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#dbeafe"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>rol</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_rol"><FONT POINT-SIZE="10"><B>id_rol</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nombre"><FONT POINT-SIZE="10">nombre <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="descripcion"><FONT POINT-SIZE="10">descripcion <FONT COLOR="#64748b" POINT-SIZE="8">text</FONT></FONT></TD></TR></TABLE>>];
  permiso [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#dbeafe"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>permiso</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_permiso"><FONT POINT-SIZE="10"><B>id_permiso</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="codigo"><FONT POINT-SIZE="10">codigo <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="descripcion"><FONT POINT-SIZE="10">descripcion <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="modulo"><FONT POINT-SIZE="10">modulo <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR></TABLE>>];
  rol_permiso [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#dbeafe"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>rol_permiso</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_rol"><FONT POINT-SIZE="10"><B>id_rol</B> (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_permiso"><FONT POINT-SIZE="10"><B>id_permiso</B> (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR></TABLE>>];
  menu [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#dbeafe"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>menu</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_menu"><FONT POINT-SIZE="10"><B>id_menu</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_padre"><FONT POINT-SIZE="10">id_padre (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="titulo"><FONT POINT-SIZE="10">titulo <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ruta"><FONT POINT-SIZE="10">ruta <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="icono"><FONT POINT-SIZE="10">icono <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="orden"><FONT POINT-SIZE="10">orden <FONT COLOR="#64748b" POINT-SIZE="8">smallint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_permiso"><FONT POINT-SIZE="10">id_permiso (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="activo"><FONT POINT-SIZE="10">activo <FONT COLOR="#64748b" POINT-SIZE="8">boolean</FONT></FONT></TD></TR></TABLE>>];
  bitacora_acceso [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#dbeafe"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>bitacora_acceso</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_bitacora"><FONT POINT-SIZE="10"><B>id_bitacora</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario"><FONT POINT-SIZE="10">id_usuario (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="correo"><FONT POINT-SIZE="10">correo <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="evento"><FONT POINT-SIZE="10">evento <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="recurso"><FONT POINT-SIZE="10">recurso <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="metodo"><FONT POINT-SIZE="10">metodo <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_http"><FONT POINT-SIZE="10">estado_http <FONT COLOR="#64748b" POINT-SIZE="8">smallint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ip"><FONT POINT-SIZE="10">ip <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_agent"><FONT POINT-SIZE="10">user_agent <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="detalle"><FONT POINT-SIZE="10">detalle <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha"><FONT POINT-SIZE="10">fecha <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR></TABLE>>];
  visita_pagina [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#dbeafe"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>visita_pagina</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_visita"><FONT POINT-SIZE="10"><B>id_visita</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pagina"><FONT POINT-SIZE="10">pagina <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="contador"><FONT POINT-SIZE="10">contador <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ultima_visita"><FONT POINT-SIZE="10">ultima_visita <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR></TABLE>>];
  auditoria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#dbeafe"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>auditoria</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_auditoria"><FONT POINT-SIZE="10"><B>id_auditoria</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario"><FONT POINT-SIZE="10">id_usuario (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="accion"><FONT POINT-SIZE="10">accion <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="entidad"><FONT POINT-SIZE="10">entidad <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_entidad"><FONT POINT-SIZE="10">id_entidad <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="detalle"><FONT POINT-SIZE="10">detalle <FONT COLOR="#64748b" POINT-SIZE="8">json</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="canal"><FONT POINT-SIZE="10">canal <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ip"><FONT POINT-SIZE="10">ip <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha"><FONT POINT-SIZE="10">fecha <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR></TABLE>>];
  notificacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="#dbeafe"><TR><TD BGCOLOR="#1f3a5f"><FONT COLOR="white" POINT-SIZE="12"><B>notificacion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_notificacion"><FONT POINT-SIZE="10"><B>id_notificacion</B> <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario"><FONT POINT-SIZE="10">id_usuario (FK) <FONT COLOR="#64748b" POINT-SIZE="8">bigint</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo"><FONT POINT-SIZE="10">tipo <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="asunto"><FONT POINT-SIZE="10">asunto <FONT COLOR="#64748b" POINT-SIZE="8">varchar</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mensaje"><FONT POINT-SIZE="10">mensaje <FONT COLOR="#64748b" POINT-SIZE="8">text</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="leida"><FONT POINT-SIZE="10">leida <FONT COLOR="#64748b" POINT-SIZE="8">boolean</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="enviada_correo"><FONT POINT-SIZE="10">enviada_correo <FONT COLOR="#64748b" POINT-SIZE="8">boolean</FONT></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="fecha"><FONT POINT-SIZE="10">fecha <FONT COLOR="#64748b" POINT-SIZE="8">timestamp</FONT></FONT></TD></TR></TABLE>>];
  usuario:id_rol -> rol [arrowhead=normal];
  notificacion:id_usuario -> usuario [arrowhead=normal];
  auditoria:id_usuario -> usuario [arrowhead=normal];
  rol_permiso:id_rol -> rol [arrowhead=normal];
  rol_permiso:id_permiso -> permiso [arrowhead=normal];
  menu:id_permiso -> permiso [arrowhead=normal];
  menu:id_padre -> menu [arrowhead=normal];
  bitacora_acceso:id_usuario -> usuario [arrowhead=normal];
}